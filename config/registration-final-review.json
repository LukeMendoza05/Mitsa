  "exactSelectSources": {
    "guard": {
      "sha256": "ac82bb1f50ffa1eb29efdc54fab07b3d9c1817430caa262c79728058a2aec644",
      "sql": "select\n (select marker from foundation_probe.environment_identity where singleton) marker,\n (select jsonb_build_object('admission',admission_enabled,'delivery',delivery_enabled,'transport',transport_ready,'security',session_policy_ready,'policy',session_policy,'termsSelected',terms_id is not null,'privacySelected',privacy_id is not null) from private.registration_control where singleton) controls,\n (select not(registration_enabled or external_mail_enabled or legal_publication_enabled or eligibility_approved or disposal_enabled) from private.release_gates where singleton) release_closed,\n (select not(enabled or smtp_enabled) from private.pilot_registration_window where singleton) pilot_closed,\n has_schema_privilege('app_registration','auth','USAGE') registration_auth_usage,\n has_schema_privilege('app_registration','private','CREATE') registration_private_create,\n coalesce(has_function_privilege(to_regprocedure('extensions.hmac(bytea,bytea,text)'),'EXECUTE'),false) hmac_available,\n (select jsonb_agg(jsonb_build_object('schema',n.nspname,'table',c.relname,'columns',(select jsonb_agg(jsonb_build_object('name',a.attname,'type',format_type(a.atttypid,a.atttypmod),'position',a.attnum) order by a.attnum) from pg_attribute a where a.attrelid=c.oid and a.attnum>0 and not a.attisdropped),'keys',coalesce((select jsonb_agg(a.attname::text order by k.position) from pg_index i cross join lateral unnest(i.indkey) with ordinality k(attnum,position) join pg_attribute a on a.attrelid=c.oid and a.attnum=k.attnum where i.indrelid=c.oid and i.indisprimary),'[]'::jsonb)) order by n.nspname,c.relname) from pg_class c join pg_namespace n on n.oid=c.relnamespace where c.relkind in ('r','p') and (n.nspname in ('private','foundation_probe') or (n.nspname='auth' and c.relname in ('users','mfa_factors','identities')))) registry"
    },
    "security": {
      "policies": {
        "sha256": "42408cf1509524ddf0829f634dd3eda5b1d999d205074832c019b815455612f6",
        "sql": "select to_jsonb(p) p from pg_policies p where schemaname in ('private','foundation_probe','auth') order by schemaname,tablename,policyname"
      },
      "relations": {
        "sha256": "31409e7219e77774cf11e340137a578c472d146ca91d4f6e4266c5eff637085a",
        "sql": "select n.nspname schema,c.relname name,pg_get_userbyid(c.relowner) owner,c.relacl::text acl,c.relrowsecurity rls,c.relforcerowsecurity forced from pg_class c join pg_namespace n on n.oid=c.relnamespace where n.nspname in ('private','foundation_probe','auth') and c.relkind in ('r','p') order by 1,2"
      },
      "columnAcls": {
        "sha256": "d9bb70548a7449bbac8d8f93df5004748e892b792c04f02fdca87ff0a5ddfb03",
        "sql": "select n.nspname schema,c.relname name,a.attname column,a.attacl::text acl from pg_attribute a join pg_class c on c.oid=a.attrelid join pg_namespace n on n.oid=c.relnamespace where n.nspname in ('private','foundation_probe','auth') and c.relkind in ('r','p') and a.attnum>0 and not a.attisdropped order by 1,2,a.attnum"
      },
      "functions": {
        "sha256": "82ec271465d1eb9b2ce3317d3c1c53317cbc4670a754e6e6543d27c2edf929f3",
        "sql": "select n.nspname schema,p.proname name,pg_get_function_identity_arguments(p.oid) signature,pg_get_userbyid(p.proowner) owner,p.prosecdef definer,p.proconfig settings,p.proacl::text acl,encode(sha256(convert_to(pg_get_functiondef(p.oid),'UTF8')),'hex') digest from pg_proc p join pg_namespace n on n.oid=p.pronamespace where n.nspname in ('private','api','foundation_probe') and p.prokind in ('f','p') order by 1,2,3"
      },
      "roles": {
        "sha256": "75c712725d56b44531623eeeec53eb988e8d1df493d55317f10fc923bed8bb6c",
        "sql": "select r.rolname name,r.rolsuper superuser,r.rolbypassrls bypassrls,r.rolcanlogin login,r.rolcreaterole createrole,r.rolcreatedb createdb,r.rolinherit inherit,(select coalesce(jsonb_agg(pg_get_userbyid(m.roleid) order by m.roleid),'[]'::jsonb) from pg_auth_members m where m.member=r.oid) memberships from pg_roles r where r.rolname in ('app_registration','app_workspace','anon','authenticated','service_role','supabase_auth_admin','postgres') order by r.rolname"
      },
      "migrations": {
        "sha256": "549fd05cd9ae3c50aa72cffd4476bcaab3d7b4900a76776087981912a60598c4",
        "sql": "select version,name from supabase_migrations.schema_migrations order by version"
      },
      "schemaGrants": {
        "sha256": "130acf3bbed5343b739cfd3e87040be1d6866d33ec3ce66ef9efc25a668715cc",
        "sql": "select jsonb_build_object('schemas',(select jsonb_agg(jsonb_build_object('name',nspname,'owner',pg_get_userbyid(nspowner),'acl',nspacl::text) order by nspname) from pg_namespace where nspname in ('private','foundation_probe','auth','api','extensions')),'defaults',(select coalesce(jsonb_agg(jsonb_build_object('owner',pg_get_userbyid(defaclrole),'schema',coalesce(n.nspname,''),'kind',defaclobjtype,'acl',defaclacl::text) order by defaclrole,defaclnamespace,defaclobjtype),'[]'::jsonb) from pg_default_acl d left join pg_namespace n on n.oid=d.defaclnamespace)) grants"
      }
    },
