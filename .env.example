# Ordinary Next.js runtime: publishable key only. No administrative credentials.
SUPABASE_URL=https://mjtejwafxriwntweussc.supabase.co
SUPABASE_PUBLISHABLE_KEY=copy-the-publishable-key
APP_ORIGIN=http://127.0.0.1:3000

# Run node scripts/setup-mitsa-runtime.mjs to generate the local value privately.
# Five-minute authenticator enrollment context only; never NEXT_PUBLIC_.
MFA_ENROLLMENT_KEY=generate-a-32-byte-base64url-secret

# Public registration remains disabled. Approved isolated server-to-Edge calls
# require the same independently generated 32-byte hex key in Next and Edge only.
# This is not an anon/publishable key or Supabase administrative credential.
# Only after explicit isolated deployment/configuration approval, run
# node scripts/setup-registration-intent.mjs; never print or commit its value.
# MITSA_REGISTRATION_INTENT_KEY=generate-a-separate-32-byte-hex-secret

# Separate bounded email/recovery/invitation context encryption key.
# Generated/preserved by scripts/setup-mitsa-runtime.mjs; never NEXT_PUBLIC_.
AUTH_FLOW_KEY=generate-a-separate-32-byte-base64url-secret
# Already approved only for the pinned synthetic environment. Missing settings
# keep the flows closed; these modes do not override database hooks or allowlists.
MITSA_REGISTRATION_MODE=disabled
# development-open is local-only and still requires an approved, tested
# isolated operator lease + healthy mail heartbeat + real server Turnstile.
# Set it through the gated isolated-registration-service, never to bypass gates.
# Eventual public mode requires the published database registration/eligibility/
# legal gates plus private signing and mandatory provider email confirmation.
# It does not use per-email development allowlists. Do not select public mode
# for the isolated test target or infer authorization from this variable alone.
MITSA_AUTH_MAIL_MODE=disabled
# Help text only; set true only after the separately approved encrypted-code
# capture update has passed hosted verification. Never enables external mail.
MITSA_AUTH_CODE_CAPTURE_ENABLED=false
# Email only; matches the approved six-digit provider configuration. Eight is
# reserved for a coordinated rollback. Expiration stays 3600; TOTP is separate.
MITSA_EMAIL_OTP_LENGTH=6
# Public signup stays closed without real CAPTCHA configuration AND published
# database release gates. Never use Cloudflare's always-pass test keys for it.
MITSA_PUBLIC_CAPTCHA_PROVIDER=disabled
MITSA_TURNSTILE_SITE_KEY=
MITSA_TURNSTILE_SECRET_KEY=
# Explicit reviewed developer activation writes a private email hash here. It is
# not an authorization credential; SQL and provider hooks still enforce access.
# MITSA_DEVELOPER_EMAIL_SHA256=generated-by-the-approved-local-operator-tool
# Controlled local setup selects isolated-test / isolated-capture only after
# verifying the actual provider hooks and the approved database marker.
# Resend/Gmail delivery has no active worker or public endpoint. Do not add provider
# credentials or enable SMTP/external delivery without separate release approval.

# Tests explicitly load .secrets/operator.env; Next.js does not load that file.
# It contains TEST_PROJECT_REF, TEST_SUPABASE_URL, TEST_PUBLISHABLE_KEY,
# TEST_DATABASE_URL and TEST_AUTH_ADMIN_KEY for this isolated project only.

# Prepared persistent engine: remains inactive during Stage A. Never change
# this to persistent-v1 or launch delivery before the separate review gates.
MITSA_REGISTRATION_ENGINE=legacy
MITSA_DEPLOYMENT_PROFILE=isolated-development
# Server-only signer for the NEW private service; configure only after approval.
# Never use NEXT_PUBLIC_ or copy an operator/admin/SMTP key into Next.
MITSA_REGISTRATION_SERVICE_KEY=
